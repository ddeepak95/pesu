# Supabase Configuration
# Local Supabase (Supabase CLI, docker-backed)
# When true, uses the LOCAL URL/keys below instead of the production project.
NEXT_PUBLIC_USE_LOCAL_SUPABASE=false

# Local Supabase Instance
NEXT_PUBLIC_SUPABASE_LOCAL_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_LOCAL_ANON_KEY=your_local_supabase_anon_key

# Local service role key (server-side only)
SUPABASE_LOCAL_SERVICE_ROLE_KEY=your_local_supabase_service_role_key

# Production Supabase Instance
NEXT_PUBLIC_SUPABASE_PROD_URL=https://your-prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_PROD_ANON_KEY=your_prod_supabase_anon_key

# Pipecat Configuration
# Set to 'true' to use Pipecat Cloud, 'false' for local development
PIPECAT_USE_CLOUD=false

# For LOCAL development: Your local Pipecat server endpoint
PIPECAT_LOCAL_ENDPOINT=http://localhost:7860

# For CLOUD deployment: Your agent name on Pipecat Cloud
AGENT_NAME=pesu-pipecat

# API key for Pipecat Cloud (SERVER-SIDE ONLY - no NEXT_PUBLIC prefix!)
# Only required when PIPECAT_USE_CLOUD=true
PIPECAT_API_KEY=your_pipecat_api_key

# Firebase Admin Configuration (SERVER-SIDE ONLY - no NEXT_PUBLIC prefix!)
# Firebase Storage is used for storing voice recording audio files
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
# Option 1: Service account key as JSON string (recommended for serverless environments)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
# Option 2: Path to service account JSON file (alternative, if file-based auth is preferred)
# FIREBASE_SERVICE_ACCOUNT_PATH=./path/to/service-account-key.json

# AI credentials (SERVER-SIDE ONLY — encrypts institution/class/platform API keys at rest)
# Generate with: openssl rand -base64 32
AI_CREDENTIALS_ENCRYPTION_KEY=

# Text/chat LLM defaults when no platform row exists (Phase 2 routes use DB config when set)
# AI_PROVIDER=google
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=xxx
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=xxx

